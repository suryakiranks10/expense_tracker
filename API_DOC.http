#====================accounts=====================

#api call for register
###
POST http://127.0.0.1:8000/accounts/register/
Content-Type: application/json

{
    "username":"django",
    "email":"django@gmail.com",
    "password":"password@123",
    "phone":"98745632",
    "dob":"2026-10-27"
}

#===================token=========================

#token create
###
POST  http://127.0.0.1:8000/token/
Content-Type: application/json

{
    "username":"django",
    "password":"password@123"
}
#===================expense=======================
#api call for listing expenses
###
GET  http://127.0.0.1:8000/expenses/
Accept: application/json
Authorization: Token 7a78722f35a68501ba4e9ef575a70259469c59d1


#api call for creating expense
###
POST http://127.0.0.1:8000/expenses/
Content-Type: application/json
Authorization: Token 7a78722f35a68501ba4e9ef575a70259469c59d1

{
    "title":"trip",
    "amount":1500,
    "category":"travel"
}


#api call for retrieving detail
###
GET  http://127.0.0.1:8000/expenses/1/
Accept: application/json
Authorization: Token 7a78722f35a68501ba4e9ef575a70259469c59d1


#api call for updating 
###
PUT  http://127.0.0.1:8000/expenses/1/
Content-Type: application/json
Authorization: Token 7a78722f35a68501ba4e9ef575a70259469c59d1

{
  "id": 1,
  "title": "biriyani",
  "category": "food",
  "amount": "250.00",
  "description": null,
  "payment_method": "upi",
  "created_at": "2026-11-12T04:57:00.364092Z",
  "bill_image": null,
  "owner": 1
}


#api call for deleting
###
DELETE http://127.0.0.1:8000/expenses/1/
Accept: application/json
Authorization: Token 7a78722f35a68501ba4e9ef575a70259469c59d1


#=====================Summary====================

#summary
###
GET http://127.0.0.1:8000/expenses/summary/
Accept: application/json
Authorization: Token 7a78722f35a68501ba4e9ef575a70259469c59d1